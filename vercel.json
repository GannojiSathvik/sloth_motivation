{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/plan.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/timetable",
      "destination": "/index.html"
    },
    {
      "source": "/journal",
      "destination": "/index.html"
    },
    {
      "source": "/progress",
      "destination": "/index.html"
    },
    {
      "source": "/fuel",
      "destination": "/index.html"
    },
    {
      "source": "/planner",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/todos",
      "destination": "/index.html"
    }
  ]
}
